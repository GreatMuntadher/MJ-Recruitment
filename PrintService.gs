const PRINT_HEADERS = ['Print_Token', 'Print_Link'];
function newPrintToken_(){return Utilities.getUuid().replace(/-/g,'')+Utilities.getUuid().replace(/-/g,'');}
function printUrl_(token){return 'https://script.google.com/macros/s/AKfycby8t9J5SEcS5YtsPo8OK4Z-jopooj0_hdy_3_j9r0VoFQEADAMNOUY-x9KuR3WxVeTY/exec?action=print&token='+encodeURIComponent(token);}
function printLinkCell_(token){return {formula:'=HYPERLINK("'+printUrl_(token).replace(/"/g,'""')+'","عرض / طباعة")'};}
function backfillPrintLinks(){const lock=LockService.getScriptLock();lock.waitLock(30000);try{const sheet=book_().getSheetByName('Candidates');let headers=sheet.getRange(1,1,1,sheet.getLastColumn()).getDisplayValues()[0];PRINT_HEADERS.forEach(function(h){if(!headers.includes(h)){sheet.getRange(1,headers.length+1).setValue(h);headers.push(h);}});const rows=Math.max(0,sheet.getLastRow()-1);if(!rows)return;const tokenCol=headers.indexOf('Print_Token')+1,linkCol=headers.indexOf('Print_Link')+1;const current=sheet.getRange(2,tokenCol,rows,1).getDisplayValues();const tokens=current.map(function(r){return [r[0]||newPrintToken_()];});sheet.getRange(2,tokenCol,rows,1).setValues(tokens);sheet.getRange(2,linkCol,rows,1).setFormulas(tokens.map(function(r){return [printLinkCell_(r[0]).formula];}));}finally{lock.releaseLock();}}
function renderCandidatePrint_(token){if(!/^[a-f0-9]{64}$/i.test(String(token||'')))return invalidPrintLink_();const candidates=table_('Candidates'),tokenCol=candidates.headers.indexOf('Print_Token');if(tokenCol<0||candidates.sheet.getLastRow()<2)return invalidPrintLink_();const found=candidates.sheet.getRange(2,tokenCol+1,candidates.sheet.getLastRow()-1,1).createTextFinder(token).matchEntireCell(true).useRegularExpression(false).findNext();if(!found)return invalidPrintLink_();const values=candidates.sheet.getRange(found.getRow(),1,1,candidates.headers.length).getValues()[0];const candidate={};candidates.headers.forEach(function(h,i){candidate[h]=values[i];});const id=String(candidate.Candidate_ID||'');const experiences=table_('Candidate_Experiences'),idCol=experiences.headers.indexOf('Candidate_ID');let exp=[];if(idCol>=0&&experiences.sheet.getLastRow()>1){experiences.sheet.getRange(2,1,experiences.sheet.getLastRow()-1,experiences.headers.length).getValues().forEach(function(r){if(String(r[idCol])===id){const x={};experiences.headers.forEach(function(h,i){x[h]=r[i];});exp.push(x);}});}return HtmlService.createHtmlOutput(printHtml_(candidate,exp)).setTitle('استمارة '+id).addMetaTag('viewport','width=device-width, initial-scale=1');}
function invalidPrintLink_(){return HtmlService.createHtmlOutput('<!doctype html><html lang="ar" dir="rtl"><meta charset="utf-8"><style>body{font:16px Tahoma;padding:60px;text-align:center;color:#24333d}</style><h2>الرابط غير صالح أو لم يعد متاحًا.</h2>');}
const PRINT_LOGO_DATA_URI='data:image/png;base64,';
function printHtml_(c,experiences){
  const e=htmlEscape_;
  const value=function(v){return v===true?'نعم':v===false?'لا':v;};
  const money=function(v){return v===''||v==null?'':Number(v).toLocaleString('en-US')+' IQD';};
  const date=function(v){if(!v)return '';return v instanceof Date?Utilities.formatDate(v,Session.getScriptTimeZone(),'yyyy-MM-dd'):String(v);};
  const field=function(label,v,wide){if(v===''||v==null)return '';return '<div class="field'+(wide?' wide':'')+'"><span>'+e(label)+'</span><strong>'+e(value(v))+'</strong></div>';};
  const sections=[
    ['المعلومات الشخصية',[['first_name','الاسم الأول'],['father_name','اسم الأب'],['grandfather_name','اسم الجد'],['surname','اللقب'],['gender','الجنس'],['birth_date','تاريخ الميلاد'],['marital_status','الحالة الزوجية']]],
    ['معلومات الاتصال والسكن',[['primary_phone','رقم الهاتف الأساسي'],['secondary_phone','رقم الهاتف الثانوي'],['email','البريد الإلكتروني'],['address','عنوان السكن',true],['landmark','أقرب نقطة دالة',true]]],
    ['التحصيل الدراسي',[['education_level','التحصيل الدراسي'],['education_institution','الجامعة / المدرسة'],['graduation_year','سنة التخرج']]],
    ['الوضع الوظيفي الحالي',[['currently_employed','يعمل حاليًا'],['current_employer','جهة العمل الحالية'],['current_job_title','المسمى الحالي'],['current_start_date','تاريخ المباشرة'],['current_salary','الراتب الحالي'],['notice_period','فترة الإشعار'],['reason_for_leaving_current','سبب ترك العمل',true]]],
    ['المهارات',[['microsoft_office_level','Microsoft Office'],['computer_level','استخدام الحاسوب'],['data_entry_level','إدخال البيانات'],['erp_level','أنظمة ERP'],['excel_level','Microsoft Excel'],['english_level','اللغة الإنجليزية'],['other_technical_skills','مهارات أخرى',true]]],
    ['معلومات التقديم',[['applied_position','الوظيفة المتقدم إليها'],['expected_salary','الراتب المتوقع'],['how_heard_about_job','مصدر معرفة الوظيفة'],['available_start_date','تاريخ المباشرة المتاح'],['knows_masat_employee','يعرف موظفًا بالشركة'],['referral_employee_name','اسم الموظف'],['referral_employee_department','القسم'],['referral_relationship','العلاقة']]]
  ];
  const sectionHtml=sections.map(function(s){const body=s[1].map(function(f){let v=c[f[0]];if(f[0]==='expected_salary'||f[0]==='current_salary')v=money(v);if(f[0].indexOf('date')>=0)v=date(v);return field(f[1],v,f[2]);}).join('');return body?'<section><h2><i></i>'+e(s[0])+'</h2><div class="fields">'+body+'</div></section>':'';}).join('');
  const expHtml=experiences.map(function(x,i){const period=[date(x.Start_Date),date(x.End_Date)].filter(Boolean).join(' — ');return '<article class="experience"><h3>الخبرة '+(i+1)+'</h3><div class="fields">'+field('الشركة',x.Company)+field('المسمى الوظيفي',x.Job_Title)+field('من / إلى',period,true)+field('المهام',x.Tasks,true)+field('آخر راتب',money(x.Last_Salary))+field('سبب ترك العمل',x.Leave_Reason,true)+'</div></article>';}).join('');
  const full=['first_name','father_name','grandfather_name','surname'].map(function(k){return c[k];}).filter(String).join(' ');
  const submitted=date(c.Submission_Date||c.Submission_Timestamp);
  return '<!doctype html><html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>'+
  '@page{size:A4;margin:12mm}*{box-sizing:border-box}html,body{margin:0;background:#fff;color:#26343c;font:12.5px/1.55 Tahoma,Arial,sans-serif}body{padding-bottom:12mm}.toolbar{position:sticky;top:0;z-index:5;display:flex;gap:8px;justify-content:flex-start;padding:10px 0;background:#fff}.toolbar button{padding:9px 16px;border:1px solid #243f50;border-radius:7px;background:#243f50;color:#fff;font-weight:700;cursor:pointer}.toolbar .secondary{background:#fff;color:#243f50}.page-head{display:grid;grid-template-columns:72px 1fr auto;gap:16px;align-items:center;padding:12px 0 14px;border-bottom:2px solid #b58a39}.logo-box{width:72px;height:72px;display:flex;align-items:center;justify-content:center;border:1px solid #dbcba9;border-radius:14px;background:#fff}.logo-box img{width:58px;height:58px;object-fit:contain}.brand-name{color:#243f50;font-size:19px;font-weight:800}.form-title{color:#9a7229;font-size:15px;font-weight:700}.head-id{text-align:left;color:#67747b;font-size:10px}.head-id strong{display:block;color:#243f50;font-size:15px;direction:ltr}.summary{margin:14px 0 10px;border:1px solid #d8dedf;border-top:4px solid #b58a39;border-radius:10px;padding:12px;background:#fafbfb;break-inside:avoid}.candidate-name{margin-bottom:10px;color:#203d4d;font-size:20px;font-weight:800}.summary-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.summary-item{min-height:50px;padding:7px 9px;border-right:2px solid #c9aa6b;background:#fff}.summary-item span,.field span{display:block;color:#758087;font-size:10px}.summary-item strong{display:block;margin-top:2px;color:#26343c;font-size:12.5px}.summary-item .ltr{direction:ltr;text-align:right}section{margin-top:11px;break-inside:avoid;page-break-inside:avoid}h2{display:flex;align-items:center;gap:7px;margin:0 0 7px;color:#243f50;font-size:14px;break-after:avoid;page-break-after:avoid}h2 i{display:inline-block;width:5px;height:17px;border-radius:3px;background:#b58a39}.fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px}.field{min-height:47px;padding:7px 9px;border:1px solid #e0e5e6;border-radius:7px;background:#fff}.field.wide{grid-column:1/-1}.field strong{display:block;margin-top:2px;color:#26343c;font-size:12px;overflow-wrap:anywhere;white-space:pre-line}.experience{margin-top:8px;border:1px solid #d5dcde;border-right:4px solid #b58a39;border-radius:8px;padding:9px;break-inside:avoid;page-break-inside:avoid}.experience h3{margin:0 0 7px;color:#8a6422;font-size:13px}.footer{position:fixed;right:0;left:0;bottom:0;padding-top:4px;border-top:1px solid #d7dddf;color:#68757b;text-align:center;font-size:9.5px}.page-no:after{content:counter(page)}'+
  '@media print{html,body{font-size:11.5px}.toolbar{display:none!important}.page-head{margin-top:0}.summary,section,.experience{break-inside:avoid;page-break-inside:avoid}h2,h3{break-after:avoid;page-break-after:avoid}.summary,.summary-item,.field{background:#fff!important;-webkit-print-color-adjust:exact;print-color-adjust:exact}.logo-box{border-color:#b8b8b8}}@media(max-width:650px){.page-head{grid-template-columns:58px 1fr}.logo-box{width:58px;height:58px}.logo-box img{width:48px;height:48px}.head-id{grid-column:1/-1;text-align:right}.summary-grid,.fields{grid-template-columns:1fr}.field.wide{grid-column:auto}}'+
  '</style></head><body><div class="toolbar"><button onclick="window.print()">طباعة / حفظ PDF</button><button class="secondary" onclick="window.close()">إغلاق</button></div><header class="page-head"><div class="logo-box"><img src="'+PRINT_LOGO_DATA_URI+'" alt="شعار شركة ماسة الجود"></div><div><div class="brand-name">شركة ماسة الجود</div><div class="form-title">استمارة بيانات مرشح</div></div><div class="head-id">Candidate ID<strong>'+e(c.Candidate_ID)+'</strong></div></header><div class="summary"><div class="candidate-name">'+e(full)+'</div><div class="summary-grid"><div class="summary-item"><span>Candidate ID</span><strong class="ltr">'+e(c.Candidate_ID)+'</strong></div><div class="summary-item"><span>الوظيفة المتقدم إليها</span><strong>'+e(c.applied_position||'—')+'</strong></div><div class="summary-item"><span>الراتب المتوقع</span><strong>'+e(money(c.expected_salary)||'—')+'</strong></div><div class="summary-item"><span>الحالة</span><strong>'+e(c.Status||'—')+'</strong></div><div class="summary-item"><span>تاريخ التقديم</span><strong>'+e(submitted||'—')+'</strong></div><div class="summary-item"><span>رقم الهاتف</span><strong class="ltr">'+e(c.primary_phone||'—')+'</strong></div></div></div>'+sectionHtml+'<section><h2><i></i>الخبرات العملية</h2>'+(expHtml||'<div class="field"><span>الخبرات</span><strong>لا توجد خبرات مسجلة</strong></div>')+'</section><footer class="footer">شركة ماسة الجود | قسم الموارد البشرية <span class="page-no">| صفحة </span></footer></body></html>';
}
function htmlEscape_(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}

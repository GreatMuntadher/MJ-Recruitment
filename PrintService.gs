const PRINT_HEADERS = ['Print_Token', 'Print_Link'];
function newPrintToken_(){return Utilities.getUuid().replace(/-/g,'')+Utilities.getUuid().replace(/-/g,'');}
function printUrl_(token){return 'https://script.google.com/macros/s/AKfycby8t9J5SEcS5YtsPo8OK4Z-jopooj0_hdy_3_j9r0VoFQEADAMNOUY-x9KuR3WxVeTY/exec?action=print&token='+encodeURIComponent(token);}
function printLinkCell_(token){return {formula:'=HYPERLINK("'+printUrl_(token).replace(/"/g,'""')+'","عرض / طباعة")'};}
function backfillPrintLinks(){const lock=LockService.getScriptLock();lock.waitLock(30000);try{const sheet=book_().getSheetByName('Candidates');let headers=sheet.getRange(1,1,1,sheet.getLastColumn()).getDisplayValues()[0];PRINT_HEADERS.forEach(function(h){if(!headers.includes(h)){sheet.getRange(1,headers.length+1).setValue(h);headers.push(h);}});const rows=Math.max(0,sheet.getLastRow()-1);if(!rows)return;const tokenCol=headers.indexOf('Print_Token')+1,linkCol=headers.indexOf('Print_Link')+1;const current=sheet.getRange(2,tokenCol,rows,1).getDisplayValues();const tokens=current.map(function(r){return [r[0]||newPrintToken_()];});sheet.getRange(2,tokenCol,rows,1).setValues(tokens);sheet.getRange(2,linkCol,rows,1).setFormulas(tokens.map(function(r){return [printLinkCell_(r[0]).formula];}));}finally{lock.releaseLock();}}
function renderCandidatePrint_(token){if(!/^[a-f0-9]{64}$/i.test(String(token||'')))return invalidPrintLink_();const candidates=table_('Candidates'),tokenCol=candidates.headers.indexOf('Print_Token');if(tokenCol<0||candidates.sheet.getLastRow()<2)return invalidPrintLink_();const found=candidates.sheet.getRange(2,tokenCol+1,candidates.sheet.getLastRow()-1,1).createTextFinder(token).matchEntireCell(true).useRegularExpression(false).findNext();if(!found)return invalidPrintLink_();const values=candidates.sheet.getRange(found.getRow(),1,1,candidates.headers.length).getValues()[0];const candidate={};candidates.headers.forEach(function(h,i){candidate[h]=values[i];});const id=String(candidate.Candidate_ID||'');const experiences=table_('Candidate_Experiences'),idCol=experiences.headers.indexOf('Candidate_ID');let exp=[];if(idCol>=0&&experiences.sheet.getLastRow()>1){experiences.sheet.getRange(2,1,experiences.sheet.getLastRow()-1,experiences.headers.length).getValues().forEach(function(r){if(String(r[idCol])===id){const x={};experiences.headers.forEach(function(h,i){x[h]=r[i];});exp.push(x);}});}return HtmlService.createHtmlOutput(printHtml_(candidate,exp)).setTitle('استمارة '+id).addMetaTag('viewport','width=device-width, initial-scale=1');}
function invalidPrintLink_(){return HtmlService.createHtmlOutput('<!doctype html><html lang="ar" dir="rtl"><meta charset="utf-8"><style>body{font:16px Tahoma;padding:60px;text-align:center;color:#24333d}</style><h2>الرابط غير صالح أو لم يعد متاحًا.</h2>');}
function printHtml_(c,experiences){const e=htmlEscape_,money=function(v){return v===''||v==null?'':Number(v).toLocaleString('en-US')+' IQD';};const sections=[['المعلومات الشخصية',[['first_name','الاسم الأول'],['father_name','اسم الأب'],['grandfather_name','اسم الجد'],['surname','اللقب'],['gender','الجنس'],['birth_date','تاريخ الميلاد'],['marital_status','الحالة الزوجية']]],['معلومات الاتصال والسكن',[['primary_phone','رقم الهاتف الأساسي'],['secondary_phone','رقم الهاتف الثانوي'],['email','البريد الإلكتروني'],['address','عنوان السكن'],['landmark','أقرب نقطة دالة']]],['التحصيل الدراسي',[['education_level','التحصيل الدراسي'],['education_institution','الجامعة / المدرسة'],['graduation_year','سنة التخرج']]],['الوضع الوظيفي الحالي',[['currently_employed','يعمل حاليًا'],['current_employer','جهة العمل الحالية'],['current_job_title','المسمى الحالي'],['current_start_date','تاريخ المباشرة'],['current_salary','الراتب الحالي'],['notice_period','فترة الإشعار'],['reason_for_leaving_current','سبب ترك العمل']]],['المهارات',[['microsoft_office_level','Microsoft Office'],['computer_level','استخدام الحاسوب'],['data_entry_level','إدخال البيانات'],['erp_level','أنظمة ERP'],['excel_level','Microsoft Excel'],['english_level','اللغة الإنجليزية'],['other_technical_skills','مهارات أخرى']]],['معلومات التقديم',[['applied_position','الوظيفة المتقدم إليها'],['expected_salary','الراتب المتوقع'],['how_heard_about_job','مصدر معرفة الوظيفة'],['available_start_date','تاريخ المباشرة المتاح'],['knows_masat_employee','يعرف موظفًا بالشركة'],['referral_employee_name','اسم الموظف'],['referral_employee_department','القسم'],['referral_relationship','العلاقة']]]];const row=function(label,value){if(value===''||value==null)return '';return '<div class="row"><span>'+e(label)+'</span><b>'+e(value===true?'نعم':value===false?'لا':value)+'</b></div>';};const sectionHtml=sections.map(function(s){const body=s[1].map(function(f){return row(f[1],f[0]==='expected_salary'?money(c[f[0]]):c[f[0]]);}).join('');return body?'<section><h2>'+e(s[0])+'</h2>'+body+'</section>':'';}).join('');const expHtml=experiences.map(function(x,i){return '<article><h3>الخبرة '+(i+1)+'</h3>'+[['Company','الشركة'],['Job_Title','المسمى الوظيفي'],['Start_Date','تاريخ البداية'],['End_Date','تاريخ النهاية'],['Tasks','المهام'],['Leave_Reason','سبب ترك العمل'],['Last_Salary','آخر راتب'],['Reference_Contact','المرجع'],['May_Contact_Reference','إمكانية التواصل']].map(function(f){return row(f[1],f[0]==='Last_Salary'?money(x[f[0]]):x[f[0]]);}).join('')+'</article>';}).join('');const full=['first_name','father_name','grandfather_name','surname'].map(function(k){return c[k];}).filter(String).join(' ');let logo='';try{const m=/logo-icon[\s\S]*?<img src="([^"]+)"/.exec(HtmlService.createHtmlOutputFromFile('Index').getContent());logo=m?m[1]:'';}catch(_){}return '<!doctype html><html lang="ar" dir="rtl"><head><meta charset="utf-8"><style>@page{size:A4;margin:14mm}*{box-sizing:border-box}body{margin:0;background:#fff;color:#202b32;font:13px/1.7 Tahoma,Arial}.actions{text-align:left;margin-bottom:12px}.actions button{margin-right:7px;padding:8px 14px;border:1px solid #244653;border-radius:5px;background:#244653;color:#fff;cursor:pointer}.head{display:flex;gap:14px;align-items:center;padding-bottom:12px;border-bottom:2px solid #b28a2e}.head img{width:54px;height:54px;object-fit:contain}.brand{flex:1}.brand strong{display:block;color:#173f4d;font-size:19px}.meta{text-align:left}.meta b{display:block;direction:ltr}.summary{margin:13px 0;padding:10px 12px;border:1px solid #cfdadd;background:#f7f9f9}.summary strong{font-size:16px;color:#173f4d}.summary-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:5px}section,article{margin-top:13px;break-inside:avoid;page-break-inside:avoid}h2,h3{margin:0;padding:6px 9px;border-right:4px solid #b28a2e;background:#edf2f3;color:#173f4d;font-size:14px;break-after:avoid}.row{display:grid;grid-template-columns:40% 60%;gap:10px;padding:5px 9px;border-bottom:1px solid #e1e7e9}.row span{color:#66747b}.row b{overflow-wrap:anywhere}article{border:1px solid #cfdadd}@media print{.actions{display:none}section,article{break-inside:avoid;page-break-inside:avoid}h2,h3{break-after:avoid;page-break-after:avoid}}@media(max-width:650px){.summary-grid,.row{grid-template-columns:1fr}.meta{text-align:right}}</style></head><body><div class="actions"><button onclick="window.print()">طباعة / حفظ PDF</button><button onclick="window.close()">إغلاق</button></div><header class="head">'+(logo?'<img src="'+e(logo)+'" alt="شعار شركة ماسة الجود">':'')+'<div class="brand"><strong>شركة ماسة الجود</strong>استمارة بيانات مرشح</div><div class="meta">Candidate ID<b>'+e(c.Candidate_ID)+'</b></div></header><div class="summary"><strong>'+e(full)+'</strong><div class="summary-grid"><span>تاريخ التقديم: '+e(c.Submission_Date||c.Submission_Timestamp)+'</span><span>الوظيفة: '+e(c.applied_position||'')+'</span><span>الحالة: '+e(c.Status||'')+'</span></div></div>'+sectionHtml+'<section><h2>الخبرات العملية</h2>'+(expHtml||row('الخبرات','لا توجد خبرات مسجلة'))+'</section></body></html>';}
function htmlEscape_(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
